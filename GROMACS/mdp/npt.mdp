; NPT equilibration
; Water model: SPC/E (Amber-compatible)

integrator               = md
dt                       = 0.002
nsteps                   = 100000 ; 200 ps

; Position restraints — restrains protein heavy atoms (posre.itp)
; and ligand heavy atoms (posre_ligand.itp)
define                   = -DPOSRES -DPOSRES_LIG

; Temperature coupling
tcoupl                   = v-rescale
tc-grps                  = Protein Non-Protein
tau_t                    = 0.1 0.1
ref_t                    = 300 300

; Pressure coupling
; FIX: Use Berendsen for equilibration (more stable than Parrinello-Rahman
; when the system is not yet at equilibrium pressure after NVT)
pcoupl                   = Berendsen
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5

; Constraints
constraints              = h-bonds
constraint_algorithm     = lincs
continuation             = yes

; Electrostatics
coulombtype              = PME
rcoulomb                 = 1.0
rvdw                     = 1.0
rlist                    = 1.0
cutoff-scheme            = Verlet
nstlist                  = 50
DispCorr                 = EnerPres
gen_vel                  = no
nstxout-compressed       = 5000     ; 10 ps
