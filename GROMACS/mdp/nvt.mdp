; NVT equilibration
; Water model: SPC/E (Amber-compatible)

integrator               = md
dt                       = 0.002
nsteps                   = 100000 ; 200 ps

; Position restraints — restrains protein heavy atoms (posre.itp)
; and ligand heavy atoms (posre_ligand.itp)
define                   = -DPOSRES -DPOSRES_LIG

; Temperature coupling
tcoupl                   = V-rescale
tc-grps                  = Protein Non-Protein
tau_t                    = 0.1 0.1
ref_t                    = 300 300

; Pressure coupling (off for NVT)
pcoupl                   = no

; Constraints
constraints              = h-bonds
constraint_algorithm     = lincs
continuation             = no

; Electrostatics
coulombtype              = PME
rcoulomb                 = 1.0
rvdw                     = 1.0
rlist                    = 1.0
cutoff-scheme            = Verlet
nstlist                  = 50
DispCorr                 = EnerPres
gen_vel                  = yes
gen_temp                 = 300
gen_seed                 = -1
nstxout-compressed       = 5000     ; 10 ps
